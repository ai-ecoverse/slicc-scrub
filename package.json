{
  "name": "@ai-ecoverse/slicc-scrub",
  "version": "0.0.0",
  "description": "Zero-dependency secret scrubber (raw, fragments, JSON, percent, HTML, base64, hex, wrapped) shared by the vault, the kernel and slicc-agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-scrub.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/slicc-scrub",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors.json": "./vectors.json"
  },
  "files": [
    "dist",
    "vectors.json"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "[ ! -e .git ] || lefthook install",
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test 'test/integration/*.test.mjs'",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test --test-force-exit 'test/unit/**/*.test.mjs'",
    "vectors": "node scripts/vectors.mjs",
    "typecheck": "tsc",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "1.29.8",
    "@biomejs/biome": "2.5.15",
    "esbuild": "0.28.2",
    "js-yaml": "5.5.0",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
